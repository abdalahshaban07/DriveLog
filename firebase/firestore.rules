rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // One document per phone, named by a random 48-character id the phone made.
    // A phone may write only its own subscription and reminders. Nobody can read or
    // list from the web. The scheduled job reads with a service account, which
    // bypasses these rules.
    match /devices/{deviceId} {
      allow create, update: if deviceId.size() == 48
        && request.resource.data.keys().hasOnly(['sub', 'tz', 'lang', 'reminders', 'updatedAt', 'sent'])
        && request.resource.data.sub is string && request.resource.data.sub.size() < 3000
        && request.resource.data.tz is string && request.resource.data.tz.size() < 64
        && request.resource.data.lang is string && request.resource.data.lang.size() < 8
        && request.resource.data.reminders is string && request.resource.data.reminders.size() < 20000
        && (!('sent' in request.resource.data) || request.resource.data.sent.size() < 20000);
      allow delete: if deviceId.size() == 48;
      allow get, list: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
